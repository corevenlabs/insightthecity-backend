# --- PostgreSQL ---
# Local: DB_HOST=localhost, DB_PORT=5432
# Cloud SQL en Cloud Run: DB_HOST=/cloudsql/<INSTANCE_CONNECTION_NAME>
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_SSL=false

PORT=3000

# --- Auth del panel admin ---
JWT_SECRET=

# --- Subida de imágenes ---
# UPLOAD_DRIVER=local  -> guarda en ./uploads (desarrollo)
# UPLOAD_DRIVER=gcs    -> sube a Cloud Storage (producción)
UPLOAD_DRIVER=local
PUBLIC_BASE_URL=http://localhost:3000
GCS_BUCKET=
GCS_PROJECT_ID=
# En local: ruta al JSON de la service account con acceso al bucket
GOOGLE_APPLICATION_CREDENTIALS=

# --- Integraciones existentes ---
OPENAI_API_KEY=
GOOGLE_PLACES_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Recuperación de contraseña por SMTP de SiteGround
SMTP_HOST=gvam1027.siteground.biz
SMTP_PORT=465
SMTP_USER=noreply@insightthecity.com
SMTP_PASSWORD=
PASSWORD_RESET_FROM=ITC Club <noreply@insightthecity.com>
# Alternativa anterior: Resend (solo se usa si SMTP_HOST no está configurado)
RESEND_API_KEY=
# URL pública del backend (sin slash final), usada dentro de los QR.
# Ejemplo: https://api.insightthecity.com
PUBLIC_BASE_URL=
